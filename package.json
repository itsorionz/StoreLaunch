{
  "name": "storelaunch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prestart": "node --env-file-if-exists=.env scripts/validate-runtime-env.mjs --production",
    "config:check": "node --env-file-if-exists=.env scripts/validate-runtime-env.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:studio": "prisma studio",
    "license:generate": "tsx backend/scripts/license.ts",
    "browser:debug": "scripts\\chrome-debug.bat",
    "test:inventory": "node --conditions=react-server --import tsx backend/tests/inventory.test.ts",
    "test:referrals": "node --conditions=react-server --import tsx backend/tests/referrals.test.ts",
    "test:ci": "npm run db:generate && npm run test:orders && npm run test:inventory && npm run test:sales && npm run test:cart-merge && npm run test:setup && npm run test:commerce-guards && npm run test:payments && npm run test:auth && npm run test:referrals && npm run test:promotions && npm run test:inbox && npm run test:chat && npm run test:admin-dashboard && npm run test:support-dashboard && npm run test:support-tickets && npm run test:search && npm run test:rider-dashboard && npm run test:validation && npm run test:warehouse-reports && npm run test:delivery-scorecard && npm run test:delivery-hubs && npm run test:stock-transfers && npm run test:rebalancing && npm run test:low-stock && npm run test:barcode && npm run test:qr && npm run test:carrier-selection && npm run test:shipment-sync && npm run test:dispatch-manifests && npm run test:cod-receivables && npm run test:owner-insights && npm run test:hrm",
    "test:sales": "node --conditions=react-server --import tsx backend/tests/sales.test.ts",
    "test:cart-merge": "node --conditions=react-server --import tsx backend/tests/cart-merge.test.ts",
    "test:setup": "node --conditions=react-server --import tsx backend/tests/setup-integrity.test.ts",
    "test:commerce-guards": "node --conditions=react-server --import tsx backend/tests/commerce-guards.test.ts",
    "test:payments": "node --conditions=react-server --import tsx backend/tests/payment-recovery.test.ts",
    "test:payments:browser": "node --import tsx backend/tests/screens-browser.mjs --payments-only",
    "payments:recover": "node --conditions=react-server --import tsx backend/scripts/payment-recovery.ts",
    "payments:worker": "node --conditions=react-server --import tsx backend/scripts/payment-recovery.ts --watch",
    "shipments:sync": "node --conditions=react-server --import tsx backend/scripts/shipment-sync.ts",
    "shipments:worker": "node --conditions=react-server --import tsx backend/scripts/shipment-sync.ts --watch",
    "test:integrity:browser": "node backend/tests/screens-browser.mjs --integrity-only",
    "test:orders": "node --conditions=react-server --import tsx backend/tests/order-integrity.test.ts",
    "test:promotions": "node --conditions=react-server --import tsx backend/tests/promotions.test.ts",
    "test:promotions:browser": "node --import tsx backend/tests/screens-browser.mjs --promotions-only",
    "test:inbox": "node --conditions=react-server --import tsx backend/tests/inbox.test.ts",
    "test:chat": "node --conditions=react-server --import tsx backend/tests/chat.test.ts",
    "test:admin-dashboard": "node --conditions=react-server --import tsx backend/tests/admin-dashboard.test.ts",
    "test:support-dashboard": "node --conditions=react-server --import tsx backend/tests/support-dashboard.test.ts",
    "test:support-tickets": "node --conditions=react-server --import tsx backend/tests/support-tickets.test.ts",
    "test:search": "node --conditions=react-server --import tsx backend/tests/product-search.test.ts",
    "test:inbox:browser": "node --import tsx backend/tests/screens-browser.mjs --inbox-only",
    "test:auth": "node --conditions=react-server --import tsx backend/tests/login-sms.test.ts",
    "test:login:browser": "node --import tsx backend/tests/login-browser.mjs",
    "test:screens": "node --import tsx backend/tests/screens-browser.mjs",
    "test:validation": "node --import tsx --test backend/tests/form-validation.test.ts",
    "test:delivery-scorecard": "node --conditions=react-server --import tsx backend/tests/delivery-scorecard.test.ts",
    "test:rider-dashboard": "node --conditions=react-server --import tsx backend/tests/rider-dashboard.test.ts",
    "test:warehouse-reports": "node --conditions=react-server --import tsx backend/tests/warehouse-reports.test.ts",
    "test:delivery-hubs": "node --conditions=react-server --import tsx backend/tests/delivery-hubs.test.ts",
    "test:stock-transfers": "node --conditions=react-server --import tsx backend/tests/stock-transfers.test.ts",
    "test:rebalancing": "node --conditions=react-server --import tsx backend/tests/rebalancing.test.ts",
    "test:low-stock": "node --conditions=react-server --import tsx backend/tests/low-stock.test.ts",
    "test:barcode": "node --conditions=react-server --import tsx backend/tests/barcode.test.ts",
    "test:qr": "node --conditions=react-server --import tsx backend/tests/qr.test.ts",
    "test:carrier-selection": "node --conditions=react-server --import tsx backend/tests/carrier-selection.test.ts",
    "test:shipment-sync": "node --conditions=react-server --import tsx backend/tests/shipment-sync.test.ts",
    "test:dispatch-manifests": "node --conditions=react-server --import tsx backend/tests/dispatch-manifests.test.ts",
    "test:cod-receivables": "node --conditions=react-server --import tsx backend/tests/cod-receivables.test.ts",
    "test:owner-insights": "node --conditions=react-server --import tsx backend/tests/owner-insights.test.ts",
    "test:hrm": "node --conditions=react-server --import tsx backend/tests/hrm.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer-v10": "npm:nodemailer@^10.2.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^6.30.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-router-dom": "^5.3.3",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0"
  }
}

enum OrderEventType {
  Placed                 @map("PLACED")
  Processing             @map("PROCESSING")
  Confirmed              @map("CONFIRMED")
  Packing                @map("PACKING")
  Packed                 @map("PACKED")
  CurrencyConfirmed      @map("CURRENCY_CONFIRMED")
  PaymentConfirmed       @map("PAYMENT_CONFIRMED")
  PaymentReviewRequired  @map("PAYMENT_REVIEW_REQUIRED")
  DeliveryAssigned       @map("DELIVERY_ASSIGNED")
  Shipped                @map("SHIPPED")
  Delivered              @map("DELIVERED")
  Cancelled              @map("CANCELLED")
  WalletRefunded         @map("WALLET_REFUNDED")
  CodCollected           @map("COD_COLLECTED")
  CodRemitted            @map("COD_REMITTED")
  DeliveryAttempted      @map("DELIVERY_ATTEMPTED")
  DeliveryProofRecorded  @map("DELIVERY_PROOF_RECORDED")
  ReturnRequested        @map("RETURN_REQUESTED")
  ReturnApproved         @map("RETURN_APPROVED")
  ReturnRejected         @map("RETURN_REJECTED")
  ReturnReceived         @map("RETURN_RECEIVED")
  ReturnInspected        @map("RETURN_INSPECTED")
  ReturnResolved         @map("RETURN_RESOLVED")
  ReturnToOriginStarted  @map("RETURN_TO_ORIGIN_STARTED")
  ReturnToOriginReceived @map("RETURN_TO_ORIGIN_RECEIVED")

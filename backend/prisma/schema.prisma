generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Customer
  Admin
  SuperAdmin
  Rider
  Support
  Warehouse
  Sales
  Manager
}

model AppRole {
  id        String        @id @default(cuid())
  name      Role          @unique
  label     String
  createdAt DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime      @updatedAt
  userRoles UserAppRole[]

  @@map("Roles")
}

model UserAppRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AppRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("UserRoles")
}

enum OrderStatus {
  Pending           @map("PENDING")
  Paid              @map("PAID")
  Processing        @map("PROCESSING")
  Confirmed         @map("CONFIRMED")
  Packing           @map("PACKING")
  Packed            @map("PACKED")
  Shipped           @map("SHIPPED")
  ReturningToOrigin @map("RETURNING_TO_ORIGIN")
  Delivered         @map("DELIVERED")
  Cancelled         @map("CANCELLED")
}

enum AfterSalesKind {
  Cancellation
  Return
  Replacement
}

enum ContactChannel {
  Email @map("EMAIL")
  Phone @map("PHONE")
}

enum AfterSalesStatus {
  Requested
  Approved
  Rejected
  Received
  Inspected
  Resolved
}

enum ReturnDisposition {
  Resellable
  Damaged
  WriteOff
}

enum RefundTender {
  Wallet
  Gateway
  Cash
}

enum RefundStatus {
  Completed
  AwaitingExternal
}

enum InventoryAdjustmentReason {
  Manual
  Receiving
  Stocktake
  Restock
  Dispatch
}

enum CodSettlementMethod {
  Cash
  BankTransfer
  MobileFinancialService
  Other
}

enum ReviewStatus {
  Pending  @map("PENDING")
  Approved @map("APPROVED")
  Hidden   @map("HIDDEN")
}

enum CareerJobStatus {
  Draft
  Published
  Closed
}

enum CareerEmploymentType {
  FullTime
  PartTime
  Contract
  Internship
}

enum CareerWorkplaceMode {
  OnSite
  Hybrid
  Remote
}

enum CareerApplicationStatus {
  New
  Reviewing
  Shortlisted
  Rejected
  Hired
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  active                  Boolean                  @default(true)
  sessionVersion          Int                      @default(0)
  roles                   Role[]                   @default([Customer])
  phone                   String?
  referralCode            String?                  @unique
  referralsSent           Referral[]               @relation("ReferralSender")
  referralReceived        Referral?                @relation("ReferralRecipient")
  gender                  String?
  dateOfBirth             DateTime?
  profilePhoto            Bytes?
  profilePhotoVersion     String?
  createdAt               DateTime                 @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt               DateTime                 @updatedAt
  addresses               Address[]
  orders                  Order[]
  reviews                 Review[]
  cart                    Cart?
  wallet                  Wallet?
  stockNotifications      StockNotification[]
  wishlists               Wishlist[]
  riderReviews            RiderReview[]
  riderProfile            Rider?
  loginChallenges         LoginChallenge[]
  passwordResetChallenges PasswordResetChallenge[]
  contactVerificationOtps ContactVerificationOtp[]
  feedback                Feedback[]
  /** Sales-rep commission rate in basis points (500 = 5%) for POS orders. */
  commissionBps           Int                     @default(0)
  salesRepOrders          Order[]                 @relation("SalesRepOrders")
  inboxMessages           InboxMessage[]
  afterSalesRequests      AfterSalesRequest[]
  chatConversations       ChatConversation[]      @relation("ChatCustomer")
  agentConversations      ChatConversation[]      @relation("ChatAgent")
  supportTickets          SupportTicket[]         @relation("TicketCustomer")
  agentTickets            SupportTicket[]         @relation("TicketAgent")
  pickedPickLists         PickList[]              @relation("PickedBy")
  packedPickLists         PickList[]              @relation("PackedBy")
  employee                Employee?
  attendanceMarked        AttendanceRecord[]
  leaveDecisions          LeaveRequest[]
  payrollRunsCreated      PayrollRun[]
  reviewsGiven            PerformanceReview[]

  roleAssignments         UserAppRole[]

  @@index([createdAt])
  @@map("Users")
}

enum InboxCategory {
  PROMOTION
  NOTIFICATION
}

model InboxMessage {
  id          String        @id @default(cuid())
  userId      String
  category    InboxCategory
  title       String
  body        String
  href        String?
  sourceKey   String
  promotionId String?
  promotion   Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  readAt      DateTime?
  createdAt   DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, category, createdAt])
  @@index([userId, readAt])
  @@index([promotionId, readAt])
}

enum ChatConversationStatus {
  Open
  Closed
}

model ChatConversation {
  id                String                  @id @default(cuid())
  customerId        String
  customerServiceId String?
  status            ChatConversationStatus  @default(Open)
  subject           String?
  orderId           String?
  lastMessageAt     DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  closedAt          DateTime?
  createdAt         DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt         DateTime                @updatedAt
  customer          User                    @relation("ChatCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  agent             User?                   @relation("ChatAgent", fields: [customerServiceId], references: [id], onDelete: SetNull)
  messages          ChatMessage[]

  supportTickets SupportTicket[]

  @@index([status, lastMessageAt])
  @@index([customerId, status])
  @@index([customerServiceId, status])
}

enum SupportTicketStatus {
  Open
  InProgress
  Waiting
  Resolved
  Closed
}

enum SupportTicketPriority {
  Low
  Normal
  High
  Urgent
}

enum SupportTicketCategory {
  OrderStatus
  Payment
  Refund
  Return
  Delivery
  Account
  Product
  Other
}

enum SupportTicketSource {
  Chat
  Order
  Manual
}

model SupportTicket {
  id              String                @id @default(cuid())
  number          String                @unique
  subject         String
  status          SupportTicketStatus   @default(Open)
  priority        SupportTicketPriority @default(Normal)
  category        SupportTicketCategory @default(Other)
  source          SupportTicketSource   @default(Manual)
  customerId      String
  orderId         String?
  conversationId  String?
  assignedToId    String?
  escalatedAt     DateTime?
  escalationNote  String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastActivityAt  DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  createdAt       DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt       DateTime              @updatedAt
  customer        User                  @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  conversation    ChatConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTo      User?                 @relation("TicketAgent", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           SupportTicketNote[]

  @@index([status, lastActivityAt])
  @@index([assignedToId, status])
  @@index([customerId, createdAt])
  @@index([orderId])
}

model SupportTicketNote {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole Role
  body       String
  createdAt  DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model ChatMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     Role
  body           String
  readAt         DateTime?
  createdAt      DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  conversation   ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, senderRole, readAt])
}

enum PromotionStatus {
  Draft
  Sent
}

enum PromotionAudience {
  AllCustomers
  SelectedCustomers
}

model Promotion {
  id              String            @id @default(cuid())
  title           String
  body            String
  href            String?
  campaignId      String?
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  audience        PromotionAudience @default(AllCustomers)
  selectedUserIds String[]          @default([])
  status          PromotionStatus   @default(Draft)
  createdById     String
  createdByName   String
  sentById        String?
  sentByName      String?
  recipientCount  Int               @default(0)
  sentAt          DateTime?
  messages        InboxMessage[]
  createdAt       DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  message   String
  rating    Int?
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CareerJob {
  id             String               @id @default(cuid())
  slug           String               @unique
  title          String
  department     String
  location       String
  employmentType CareerEmploymentType
  workplaceMode  CareerWorkplaceMode
  summary        String
  description    String
  requirements   String[]             @default([])
  status         CareerJobStatus      @default(Draft)
  closesAt       DateTime?
  publishedAt    DateTime?
  createdById    String
  createdByName  String
  createdAt      DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt      DateTime             @updatedAt
  applications   CareerApplication[]

  @@index([status, publishedAt])
  @@index([closesAt])
}

model CareerApplication {
  id                String                  @id @default(cuid())
  jobId             String
  name              String
  email             String
  phone             String
  resumeUrl         String?
  resumeFile        Bytes?
  resumeFileName    String?
  resumeMimeType    String?
  coverLetter       String
  consentAcceptedAt DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  status            CareerApplicationStatus @default(New)
  createdAt         DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt         DateTime                @updatedAt
  job               CareerJob               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  employee          Employee?

  @@unique([jobId, email])
  @@index([jobId, status, createdAt])
  @@index([email, createdAt])
}

model LoginChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetChallenge {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthRecoveryRequest {
  id             String   @id @default(cuid())
  identifierHash String
  createdAt      DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([identifierHash, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balanceCents Int                 @default(0)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt    DateTime            @updatedAt
}

enum WalletTxType {
  ReferralReward
  GIFT
  ORDER_PAYMENT
  REFUND
  ADJUSTMENT
}

enum PaymentMethod {
  COD
  GATEWAY
}

model WalletTransaction {
  id                String       @id @default(cuid())
  walletId          String
  amountCents       Int
  balanceAfterCents Int
  type              WalletTxType
  orderId           String?
  note              String?
  createdAt         DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  wallet            Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order             Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([orderId])
}

model StoreSettings {
  id                           String    @id @default(cuid())
  singletonKey                 Int       @unique @default(1)
  currencyLockedAt             DateTime?
  storeName                    String    @default("My Store")
  referralEnabled              Boolean   @default(true)
  referralRewardCents          Int       @default(4000)
  logoUrl                      String?
  primaryColor                 String    @default("#0f7b4f")
  currencySymbol               String    @default("৳")
  currencyCode                 String    @default("BDT")
  language                     String    @default("en")
  contactEmail                 String?
  contactPhone                 String?
  address                      String?
  headerAnnouncement           String?
  headerAnnouncementBackground String    @default("#e6f4ec")
  headerAnnouncementDirection  String    @default("left")
  headerAnnouncementSpeed      Int       @default(24)
  headerSupportLabel           String?
  emailVerificationSubject     String    @default("Verify your email address")
  emailVerificationBody        String    @default("Your verification code is {{code}}. It expires in {{minutes}} minutes.")
  smsVerificationBody          String    @default("Your verification code is {{code}}. It expires in {{minutes}} minutes.")
  careerNotificationEmail      String?
  careerEmailSubject           String    @default("New career application: {{jobTitle}}")
  careerEmailBody              String    @default("A new application was submitted for {{jobTitle}}.\n\nApplicant: {{applicantName}}\nEmail: {{applicantEmail}}\nPhone: {{applicantPhone}}\nResume: {{resume}}\n\nCover letter:\n{{coverLetter}}\n\nReview application {{applicationId}} in the admin dashboard.")
  deliveryEstimate             String    @default("12-24 HOURS")
  returnWindowDays             Int       @default(7)
  deliveryFeeCents             Int       @default(0)
  freeShippingOverCents        Int?
  setupCompletedAt             DateTime?
  createdAt                    DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt                    DateTime  @updatedAt
}

model Referral {
  id                String    @id @default(cuid())
  referrerId        String
  refereeId         String    @unique
  rewardCents       Int
  currencyCode      String
  rewardedAt        DateTime?
  qualifyingOrderId String?   @unique
  createdAt         DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  referrer          User      @relation("ReferralSender", fields: [referrerId], references: [id], onDelete: Restrict)
  referee           User      @relation("ReferralRecipient", fields: [refereeId], references: [id], onDelete: Restrict)
  qualifyingOrder   Order?    @relation(fields: [qualifyingOrderId], references: [id], onDelete: Restrict)

  @@index([referrerId, createdAt])
}

model License {
  id          String    @id @default(cuid())
  keyHash     String    @unique
  storeSlug   String?
  expiresAt   DateTime?
  activatedAt DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
}

/// Keys issued to customers from the admin license screen.
/// The full key is kept so it can be re-copied later; revoking only marks it
/// here (keys are verified offline, so a revoked key can't be recalled from a
/// customer instance that already activated it).
model IssuedLicense {
  id        String    @id @default(cuid())
  key       String    @unique
  label     String
  storeSlug String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([createdAt])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  nameBn    String?
  slug      String     @unique
  imageUrl  String?
  order     Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  nameBn    String?
  slug      String    @unique
  imageUrl  String?
  products  Product[]
  createdAt DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime  @updatedAt
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  nameBn               String?
  slug                 String                @unique
  description          String                @default("")
  descriptionBn        String?
  priceCents           Int
  salePriceCents       Int?
  costCents            Int?
  stock                Int                   @default(0)
  sku                  String?               @unique
  barcode              String?
  weightGrams          Int?
  lengthMm             Int?
  widthMm              Int?
  heightMm             Int?
  reorderPoint         Int               @default(0)
  images               String[]              @default([])
  flashSale            Boolean               @default(false)
  featured             Boolean               @default(false)
  active               Boolean               @default(true)
  categoryId           String
  brandId              String?
  category             Category              @relation(fields: [categoryId], references: [id])
  brand                Brand?                @relation(fields: [brandId], references: [id])
  reviews              Review[]
  orderItems           OrderItem[]
  cartItems            CartItem[]
  stockNotifications   StockNotification[]
  wishlistedBy         Wishlist[]
  campaignOffers       CampaignProduct[]
  inventoryAdjustments InventoryAdjustment[]
  stockMovements StockMovement[]
  stockLevels          StockLevel[]
  purchaseOrderLines   PurchaseOrderLine[]
  receiptLines         ReceiptLine[]
  stockTransfers       StockTransfer[]
  createdAt            DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt            DateTime              @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([barcode])
  @@index([active, flashSale])
  @@index([active, featured])
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  requestKey        String   @unique
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorId           String
  actorName         String
  delta             Int
  previousStock     Int
  newStock          Int
  expectedUpdatedAt DateTime
  reason            String
  reasonCode        InventoryAdjustmentReason @default(Manual)
  warehouseId       String?
  warehouse         Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
}

model Campaign {
  id         String            @id @default(cuid())
  title      String
  imageUrl   String
  linkUrl    String
  order      Int               @default(0)
  active     Boolean           @default(true)
  flashSale  Boolean           @default(false)
  showOnHome Boolean           @default(false)
  showInCart Boolean           @default(false)
  products   CampaignProduct[]
  promotions Promotion[]
  createdAt  DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt  DateTime          @updatedAt
}

model CampaignProduct {
  campaignId      String
  productId       String
  offerPriceCents Int
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

model CarouselSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  linkUrl   String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  code       String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([phone, createdAt])
}

model ContactVerificationOtp {
  id            String         @id @default(cuid())
  userId        String
  channel       ContactChannel
  target        String
  previousValue String?
  codeHash      String
  attempts      Int            @default(0)
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, target, createdAt])
  @@index([channel, target, createdAt])
  @@index([expiresAt])
}

model StockNotification {
  id         String    @id @default(cuid())
  userId     String
  productId  String
  notifiedAt DateTime?
  createdAt  DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Review {
  id        String       @id @default(cuid())
  rating    Int
  body      String       @default("")
  status    ReviewStatus @default(Pending)
  productId String
  userId    String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  selected  Boolean @default(true)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

enum AddressType {
  HOME
  OFFICE
  OTHER
}

enum OrderCurrencySource {
  Snapshot             @map("SNAPSHOT")
  InferredFromSettings @map("INFERRED_FROM_SETTINGS")
  AdminConfirmed       @map("ADMIN_CONFIRMED")
  Unrecorded           @map("UNRECORDED")
}

enum OrderSource {
  Web
  SalesRep
  Phone
  Whatsapp
  Admin
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  name      String
  phone     String
  type      AddressType @default(HOME)
  line1     String
  line2     String?
  city      String
  region    String?
  postal    String?
  isDefault Boolean     @default(false)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  createdAt DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime    @updatedAt
}

enum DeliveryZoneMode {
  OwnRider
  Courier
}

model DeliveryZone {
  id                String          @id @default(cuid())
  name              String
  areas             String[]        @default([])
  mode              DeliveryZoneMode @default(OwnRider)
  deliveryCompanyId String?
  deliveryCompany   DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  warehouseId       String?
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  deliveryHubId     String?
  deliveryHub       DeliveryHub?    @relation(fields: [deliveryHubId], references: [id], onDelete: SetNull)
  rateCents         Int             @default(0)
  codFeeCents       Int             @default(0)
  freeOverCents     Int?
  etaDaysFrom       Int             @default(1)
  etaDaysTo         Int             @default(3)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt         DateTime        @updatedAt
  orders            Order[]

  @@index([warehouseId])
  @@index([deliveryHubId])
}

enum LabelFormat {
  A4
  Thermal
}

model DeliveryCompany {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  trackingUrl String?
  providerKey String?
  apiBaseUrl  String?
  apiClientId String?
  apiSecret   String?
  storeId     String?
  // §5.3 volume discount: basis points off live quotes once the carrier ships
  // at least volumeMinParcels parcels in the trailing 30 days (0 disables).
  volumeDiscountBps Int        @default(0)
  volumeMinParcels  Int        @default(0)
  // §5.4 default shipping-label layout; per-order ?format= overrides it.
  labelFormat       LabelFormat @default(A4)
  active      Boolean  @default(true)
  createdAt   DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt   DateTime @updatedAt
  orders      Order[]
  deliveryZones DeliveryZone[]
  shipments   Shipment[]
  manifests   DispatchManifest[]
}
enum ShipmentProviderMode {
  Manual
  Api
}

enum ShipmentStatus {
  Pending
  Created
  InTransit
  OutForDelivery
  Delivered
  Failed
  Returned
  Shipped
}

model Shipment {
  id               String              @id @default(cuid())
  orderId          String              @unique
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryCompanyId String?
  deliveryCompany  DeliveryCompany?    @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  trackingNumber   String?
  status           ShipmentStatus      @default(Pending)
  statusHistory    Json?
  labelUrl         String?
  // §10 cost/parcel: the effective carrier quote (after volume discount) at
  // dispatch; null when the carrier could not quote (manual/pinned mode).
  costCents        Int?
  handedOverAt     DateTime?
  lastSyncedAt     DateTime?
  providerMode     ShipmentProviderMode @default(Manual)
  createdAt        DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([status], map: "Shipment_status_idx2")
}

enum DispatchManifestKind {
  Rider
  Courier
}

enum DispatchManifestStatus {
  Open
  HandedOver
}

model DispatchManifest {
  id                String                   @id @default(cuid())
  number            String                   @unique
  kind              DispatchManifestKind
  warehouseId       String?
  warehouse         Warehouse?               @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  riderId           String?
  rider             Rider?                   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  deliveryCompanyId String?
  deliveryCompany   DeliveryCompany?         @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  status            DispatchManifestStatus   @default(Open)
  createdAt         DateTime                 @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  handedOverAt      DateTime?

  conditionNote     String?
  request           AfterSalesRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  orderItem         OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([requestId, orderItemId])
  @@index([orderItemId])

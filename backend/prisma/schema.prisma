  varianceReason   String?
  settlement       CodSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  codCollection    CodCollection @relation(fields: [codCollectionId], references: [id], onDelete: Restrict)

  @@unique([settlementId, codCollectionId])
  @@index([codCollectionId])

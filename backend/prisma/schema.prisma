model RefundRecord {
  id                String             @id @default(cuid())
  requestId         String?
  orderId           String?
  tender            RefundTender
  status            RefundStatus
  amountCents       Int
  currencyCode      String
  externalReference String?
  completedById     String
  completedByName   String
  createdAt         DateTime           @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  request           AfterSalesRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict)
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([requestId, tender])
  @@unique([orderId, tender])
  @@index([status, createdAt])
  @@index([orderId, tender, status])
}

model AccountStatusEvent {
  id             String   @id @default(cuid())
  userId         String?
  riderId        String?
  actorId        String
  actorName      String
  previousActive Boolean
  active         Boolean
  createdAt      DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([userId, createdAt])
  @@index([riderId, createdAt])
}
model Warehouse {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  address     String?
  city        String?
  region      String?
  isDefault   Boolean     @default(false)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt   DateTime    @updatedAt
  stockLevels StockLevel[]
  stockMovements StockMovement[]
  receipts    Receipt[]
  inventoryAdjustments InventoryAdjustment[]
  orders      Order[]
  pickLists   PickList[]
  dispatchManifests DispatchManifest[]
  purchaseOrders PurchaseOrder[]
  deliveryHubs DeliveryHub[]
  deliveryZones DeliveryZone[]
  transfersOut StockTransfer[] @relation("TransferSource")
  transfersIn  StockTransfer[] @relation("TransferDestination")
}

model StockLevel {

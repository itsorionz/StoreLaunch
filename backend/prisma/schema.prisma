  @@index([riderId, createdAt])
}

model DeliveryProof {
  id           String   @id @default(cuid())
  orderId      String   @unique
  riderId      String
  receivedBy   String
  relationship String
  note         String
  photoKey     String?
  photoMime    String?
  photoData    Bytes?

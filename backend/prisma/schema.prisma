model AfterSalesRequest {
  id                      String           @id @default(cuid())
  orderId                 String
  userId                  String
  kind                    AfterSalesKind
  status                  AfterSalesStatus @default(Requested)
  reason                  String
  customerNote            String?
  adminNote               String?
  externalRefundReference String?
  requestedAt             DateTime         @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  reviewedAt              DateTime?
  receivedAt              DateTime?
  inspectedAt             DateTime?
  resolvedAt              DateTime?
  order                   Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                   AfterSalesItem[]
  refunds                 RefundRecord[]

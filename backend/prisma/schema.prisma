  @@index([warehouseId])
}

model DispatchManifestLine {
  id         String           @id @default(cuid())
  manifestId String
  manifest   DispatchManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([manifestId, orderId])
}
model Rider {
  id        String            @id @default(cuid())
  name      String
  phone     String
  active    Boolean           @default(true)
  userId    String?           @unique
  createdAt DateTime          @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime          @updatedAt
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders    Order[]
  attempts  DeliveryAttempt[]

enum StockTransferStatus {
  Pending
  InTransit
  Received
  Cancelled
}

/// Inter-warehouse stock movement with in-transit tracking and approval:
/// request (Pending) → dispatch (InTransit, stock leaves source) → receive
/// (Received, stock lands at destination). Cancellation from Pending or
/// InTransit restores source stock that was already dispatched.
model StockTransfer {
  id              String              @id @default(cuid())
  productId       String
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferSource", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferDestination", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  qty             Int
  status          StockTransferStatus @default(Pending)
  note            String?
  requestedById   String?
  requestedByName String?
  dispatchedById  String?
  dispatchedByName String?
  receivedById    String?
  receivedByName  String?
  requestedAt     DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  dispatchedAt    DateTime?
  receivedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model Supplier {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  note      String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime       @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {

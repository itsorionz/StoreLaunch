  Other
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

enum EmployeeDocumentKind {
  Contract
  NationalId
  Passport
  Tax
  Certificate
  Other
}

model Employee {
  id                    String                @id @default(cuid())
  employeeCode          String                @unique
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId         String?               @unique
  application           CareerApplication?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  designation           String
  department            String
  employmentType        EmploymentType        @default(FullTime)
  status                EmployeeStatus        @default(Active)
  joinDate              DateTime
  probationEndDate      DateTime?
  exitDate              DateTime?
  monthlySalaryCents    Int?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt             DateTime              @updatedAt
  attendance            AttendanceRecord[]
  leaveRequests         LeaveRequest[]
  payslips              Payslip[]
  reviews               PerformanceReview[]
  documents             EmployeeDocument[]

  @@index([status, department])
  @@index([joinDate])
}

model AttendanceRecord {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /** Bangladesh-midnight instant of the calendar day this record covers. */
  date          DateTime
  status        AttendanceStatus
  checkInAt     DateTime?
  checkOutAt    DateTime?
  workedMinutes Int?
  note          String?
  markedById    String?
  markedBy      User?            @relation(fields: [markedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  /** Bangladesh-midnight instants; both are inclusive calendar days. */
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus  @default(Pending)
  decidedById String?
  decidedBy   User?        @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt   DateTime     @updatedAt

  @@index([status, startDate])
  @@index([employeeId, startDate])
}

model PayrollRun {
  id            String       @id @default(cuid())
  /** First Bangladesh-midnight instant of the salary month. */
  month         DateTime     @unique
  currencyCode  String
  note          String?
  createdByById String?
  createdBy     User?        @relation(fields: [createdByById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  payslips      Payslip[]

  @@index([month])
}

model Payslip {
  id              String      @id @default(cuid())
  runId           String
  run             PayrollRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalaryCents Int
  allowancesCents Int         @default(0)
  deductionsCents Int         @default(0)
  /** base + allowances − deductions, always recomputed server-side. */
  netCents        Int
  note            String?
  paidAt          DateTime?
  createdAt       DateTime    @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt       DateTime    @updatedAt

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model PerformanceReview {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  /** 1 (needs support) – 5 (exceptional). */
  rating       Int
  summary      String?
  strengths     String?
  improvements String?
  goals        String?
  createdAt    DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt    DateTime @updatedAt

  @@index([employeeId, periodStart])
}

model EmployeeDocument {
  id         String               @id @default(cuid())
  employeeId String
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       EmployeeDocumentKind
  title      String
  /** Stored file (PDF/image, like career resumes) or an external link. */
  fileName   String?
  mimeType   String?
  bytes      Bytes?
  url        String?
  createdAt  DateTime             @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))

  @@index([employeeId, kind])
}

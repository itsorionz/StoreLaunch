  dispatchManifests DispatchManifest[]
}

model RiderReview {
  id        String   @id @default(cuid())
  rating    Int
  body      String   @default("")
  orderId   String   @unique
  userId    String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  rewardedReferral      Referral?
  id                    String              @id @default(cuid())
  number                String              @unique
  status                OrderStatus         @default(Pending)
  subtotalCents         Int
  shippingCents         Int                 @default(0)
  totalCents            Int
  walletPaidCents       Int                 @default(0)
  currencyCode          String?
  currencySymbol        String?
  currencySource        OrderCurrencySource @default(Snapshot)
  source                OrderSource         @default(Web)
  paymentMethod         PaymentMethod       @default(GATEWAY)
  recipientName         String
  additionalInfo        String?
  phone                 String
  line1                 String
  line2                 String?
  city                  String
  region                String?
  postal                String?
  zoneId                String?
  zone                  DeliveryZone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneRateCents         Int?
  zoneCodFeeCents       Int?
  deliveryHubId         String?
  deliveryHub           DeliveryHub?     @relation(fields: [deliveryHubId], references: [id], onDelete: SetNull)
  addressId             String?
  userId                String
  riderId               String?
  deliveryCompanyId     String?
  warehouseId           String?
  paymentValId          String?             @unique
  address               Address?            @relation(fields: [addressId], references: [id], onDelete: SetNull)
  user                  User                @relation(fields: [userId], references: [id])
  rider                 Rider?              @relation(fields: [riderId], references: [id], onDelete: SetNull)
  deliveryCompany       DeliveryCompany?    @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  warehouse             Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  shipment              Shipment?
  riderReview           RiderReview?
  manifestLines         DispatchManifestLine[]
  items                 OrderItem[]
  pickLists             PickList[]
  walletTransactions    WalletTransaction[]
  refunds               RefundRecord[]
  events                OrderEvent[]
  codCollection         CodCollection?
  deliveryAttempts      DeliveryAttempt[]
  deliveryProof         DeliveryProof?
  paymentAttempt        PaymentAttempt?
  afterSalesRequests    AfterSalesRequest[]
  supportTickets        SupportTicket[]
  replacementForOrderId String?
  replacementForOrder   Order?              @relation("OrderReplacements", fields: [replacementForOrderId], references: [id], onDelete: Restrict)
  replacementOrders     Order[]             @relation("OrderReplacements")
  /** Sales rep who created this POS order (OrderSource.SalesRep). */
  salesRepId            String?
  salesRep              User?               @relation("SalesRepOrders", fields: [salesRepId], references: [id], onDelete: SetNull)
  /** Commission snapshot: computed from the rep's rate at order time. */
  commissionCents       Int                 @default(0)
  idempotencyKey        String?             @unique
  replacementRequestId  String?             @unique
  replacementRequest    AfterSalesRequest?  @relation("RequestReplacementOrder", fields: [replacementRequestId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC')"))
  paidAt                DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?

  @@index([userId])
  @@index([status])
  @@index([riderId, status, deliveredAt])
  @@index([warehouseId])
  @@index([salesRepId])
  @@index([createdAt])
  @@index([paidAt])
  @@index([status, shippedAt])
}

enum PaymentAttemptStatus {
  Created
  Initiating
  Ready
  Unknown
  Failed
  Succeeded
  ReviewRequired
  Expired
}

model PaymentAttempt {
  id                   String               @id @default(cuid())
  orderId              String               @unique

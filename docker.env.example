# Copy this file to .env.docker. Replace every sample secret before production.
# Compose uses the same file for variable substitution and service environment.
POSTGRES_DB=storelaunch
POSTGRES_USER=storelaunch
POSTGRES_PASSWORD=change-this-database-password

# Docker-internal connection; the host migration command uses localhost:5433.
DATABASE_URL=postgresql://storelaunch:change-this-database-password@db:5432/storelaunch?schema=public
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRUST_HOST=true
LICENSE_SECRET=replace-with-a-different-32-byte-random-secret
NEXT_PUBLIC_BASE_URL=https://shop.example.com

# Local testing may use http://localhost:3000, SSLCommerz sandbox credentials,
# SMS_PROVIDER=disabled, and empty optional service credentials.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_SANDBOX=true
PAYMENT_RECOVERY_SECRET=
SHIPMENT_SYNC_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StoreLaunch <no-reply@store.local>

SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=
SMS_CLIENT_ID=
SMS_API_URL=

GOOGLE_MAPS_EMBED_KEY=
